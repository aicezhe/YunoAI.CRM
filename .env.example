# Copy to .env.local and fill in from your Supabase project.
# .env.local is gitignored — never commit real values.

# --- Supabase API ---------------------------------------------------------
# Dashboard -> Project Settings -> API

# Project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=

# Publishable key (sb_publishable_...). Replaces the legacy "anon" key.
# Safe to expose in principle — it is gated by Row Level Security — but this
# app keeps it server-side anyway: sign-in runs as a Server Action, so no
# Supabase credential is ever inlined into the browser bundle.
SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...). Replaces the legacy "service_role" key.
# BYPASSES Row Level Security — server-only, never in a NEXT_PUBLIC_ variable.
# The app itself never uses it; the seeding scripts do, because creating an
# auth account is an admin operation.
SUPABASE_SECRET_KEY=

# --- Database -------------------------------------------------------------
# Dashboard -> Project Settings -> Database -> Connection string -> URI.
# Used by `supabase db push` to apply migrations. Prefer the direct
# connection (port 5432); if your network has no IPv6 route to it, the
# session pooler on the same port works and takes the same command.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
